{
  "name": "greedy-runner",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "frontend:dev": "pnpm --filter @greedy-runner/frontend run dev",
    "frontend:build": "pnpm --filter @greedy-runner/frontend run build",
    "backend:dev": "pnpm --filter @greedy-runner/backend run dev",
    "backend:build": "pnpm --filter @greedy-runner/backend run build",
    "backend:start": "pnpm --filter @greedy-runner/backend run start",
    "backend:test": "pnpm --filter @greedy-runner/backend run test",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
